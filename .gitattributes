# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# ====================
# Source code
# ====================

*.lua text eol=lf
*.luac binary

# ====================
# Scripts
# ====================

# Shell scripts should always use LF
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# Batch scripts should use CRLF on checkout
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ====================
# Documentation
# ====================

*.md text eol=lf
*.txt text eol=lf
*.adoc text eol=lf
*.tex text eol=lf
*.rst text eol=lf

# ====================
# Configuration files
# ====================

*.json text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.config text eol=lf

# Git files
.gitattributes text eol=lf
.gitignore text eol=lf
.gitconfig text eol=lf

# ====================
# Build and Package files
# ====================

Makefile text eol=lf
*.mk text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf

# ====================
# Binary files
# ====================

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.webp binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
*.bz2 binary
*.7z binary
*.rar binary

# Audio/Video
*.mp3 binary
*.mp4 binary
*.wav binary
*.avi binary
*.mov binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary

# Other binary formats
*.pdf binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
